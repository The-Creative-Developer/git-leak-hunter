{
  "name": "git-leak-hunter",
  "version": "0.1.0",
  "description": "Defensive supply-chain secret-exposure scanner for full Git history and CI/CD config",
  "private": true,
  "type": "module",
  "bin": {
    "git-leak-hunter": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "tsx src/cli.ts",
    "fixtures": "tsx test/fixtures/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "bench:accuracy": "tsx bench/accuracy.ts",
    "bench:memo": "tsx bench/memoization.ts 5",
    "bench:entropy": "tsx bench/entropy-calibration.ts 10000",
    "bench:report": "tsx bench/report.ts && prettier --write docs/BENCHMARK.md",
    "bench": "npm run bench:accuracy && npm run bench:memo && npm run bench:report"
  },
  "dependencies": {
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
